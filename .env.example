# Bind address for the dashboard service.
CODEX_DASHBOARD_HOST=127.0.0.1
CODEX_DASHBOARD_PORT=8787
# Set a long random value before exposing the service outside localhost.
CODEX_DASHBOARD_TOKEN=
# Optional explicit executable. When unset, lookup order is PATH, newest VS Code
# extension, then official user/system install locations.
# CODEX_BIN=/absolute/path/to/codex
# Native Codex state/config/memories to import and manage.
CODEX_HOME=~/.codex
# Stable default for newly created tasks. Temp directories are rejected as defaults.
CODEX_DASHBOARD_DEFAULT_WORKSPACE=~
# Server directories exposed by the workspace chooser, separated with the OS path separator
# (`:` on Linux/macOS, `;` on Windows). Defaults to home plus common /data workspace roots.
CODEX_DASHBOARD_WORKSPACE_ROOTS=~
# Keep enabled to route all browser turns through one shared app-server owner.
CODEX_APP_SERVER=1
CODEX_DASHBOARD_AUTO_RESUME=1
CODEX_DASHBOARD_DATA=./data
# Optional single remote Codex server. The dashboard first tries ~/.ssh/keys and
# ssh-agent; if authentication fails it asks for the SSH username/password in the browser.
# CODEX_DASHBOARD_SSH_HOST=192.168.1.20
# CODEX_DASHBOARD_SSH_USER=ori
# CODEX_DASHBOARD_SSH_PORT=22
