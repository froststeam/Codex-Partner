[Unit]
Description=Codex Partner
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/codex-partner
EnvironmentFile=-/opt/codex-partner/.env
Environment=CODEX_DASHBOARD_DEFAULT_WORKSPACE=/home/codex
# CODEX_BIN is optional; automatic discovery prefers PATH, then VS Code, then official paths.
ExecStart=/opt/codex-partner/.venv/bin/codex-partner
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
UMask=0077
User=codex

[Install]
WantedBy=multi-user.target
